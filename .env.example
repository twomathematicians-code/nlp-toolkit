# NLP Toolkit Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# spaCy model for NER
NLP_SPACY_MODEL=en_core_web_sm

# Summarization model (HuggingFace)
NLP_SUMMARIZER_MODEL=sshleifer/distilbart-cnn-12-6

# Keyword extraction model
NLP_KEYWORD_MODEL=distilbert-base-uncased

# Maximum text length for endpoints
NLP_MAX_TEXT_LENGTH=10000

# Default language
NLP_DEFAULT_LANGUAGE=en

# CORS origins (comma-separated)
NLP_CORS_ORIGINS=*
